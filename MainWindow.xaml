<Window x:Class="QuickPrompt.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="QuickPrompt" Width="580" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Topmost="True" PreviewKeyDown="OnKeyDown" PreviewTextInput="OnTextInput" Deactivated="OnDeactivated" UseLayoutRounding="True">
  <Border Background="{StaticResource Panel}" BorderBrush="#404550" BorderThickness="1" CornerRadius="12" Padding="14,10,14,8">
    <Border.ContextMenu><ContextMenu Opened="OnMenuOpened" Closed="OnMenuClosed">
      <MenuItem Header="Edit selected prompt…" InputGestureText="F2" Click="OnEdit"/>
      <MenuItem Header="Refresh documents" InputGestureText="F5" Click="OnRefreshDocuments"/>
      <Separator Style="{StaticResource MenuSeparator}"/>
      <MenuItem Header="Settings…" InputGestureText="Ctrl+," Click="OnSettings"/>
      <Separator Style="{StaticResource MenuSeparator}"/><MenuItem Header="Exit" Click="OnExit"/>
    </ContextMenu></Border.ContextMenu>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="46"/><RowDefinition Height="40"/><RowDefinition Height="Auto"/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <Grid x:Name="LauncherHeader" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnHeaderMouseDown" Cursor="SizeAll" ToolTip="Drag to move. QuickPrompt centers again when reopened.">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="❯" Foreground="{StaticResource Accent}" FontSize="18" Margin="0,0,9,0"/>
          <TextBlock Text="quickprompt" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
          <TextBlock x:Name="HotkeyLabel" Text="ALT + SPACE" FontSize="9" Foreground="{StaticResource Muted}" Margin="8,3,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <ToggleButton x:Name="LanguageToggle" Grid.Column="1" Click="OnLanguageChanged" Cursor="Hand" ToolTip="Switch prompt language: English ↔ German" AutomationProperties.Name="German prompt language" AutomationProperties.HelpText="Off selects English. On selects German.">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="LanguageBorder" Background="Transparent" CornerRadius="6" BorderThickness="1" BorderBrush="Transparent" Padding="5,3">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="EnLabel" Text="EN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                <Border Background="#354264" BorderBrush="#6277A9" BorderThickness="1" CornerRadius="8" Width="30" Height="16" Margin="5,0">
                  <Ellipse x:Name="Knob" Fill="{StaticResource Accent}" Width="10" Height="10" HorizontalAlignment="Left" Margin="2,0"/>
                </Border>
                <TextBlock x:Name="DeLabel" Text="DE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="DeLabel" Property="Foreground" Value="{StaticResource Accent}"/><Setter TargetName="EnLabel" Property="Foreground" Value="{StaticResource Muted}"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LanguageBorder" Property="Background" Value="#242833"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="LanguageBorder" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <Button x:Name="NewPromptButton" Grid.Column="2" HorizontalAlignment="Right" Content="+  New prompt" FontSize="11" Padding="10,4" Focusable="False" Click="OnNew" ToolTip="New prompt (Ctrl+N)"/>
      </Grid>
      <Grid Grid.Row="1" Margin="0,8,0,4">
        <TextBox x:Name="SearchBox" FontSize="15" Padding="12,8,44,8" TextChanged="OnSearchChanged" AutomationProperties.Name="Search prompts"/>
        <TextBlock x:Name="SearchPlaceholder" Text="Search prompts and documents…" Foreground="{StaticResource Muted}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        <TextBlock Text="/" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" IsHitTestVisible="False"/>
      </Grid>
      <UniformGrid x:Name="CategoryTabs" Grid.Row="2" Columns="5" Margin="0,5,0,5"/>
      <Grid Grid.Row="3">
        <ListBox x:Name="PromptList" MaxHeight="324" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" MouseDoubleClick="OnDoubleClick" SelectionChanged="OnSelectionChanged" AutomationProperties.Name="Prompts">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
              <Border x:Name="Row" CornerRadius="7" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent" Background="Transparent"><ContentPresenter/></Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#242833"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#2B3449"/><Setter TargetName="Row" Property="BorderBrush" Value="#42516E"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
          </Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <Grid ToolTip="{Binding FilePath}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Description}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding ActionLabel}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <StackPanel x:Name="EmptyState" Margin="0,10" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
          <TextBlock x:Name="EmptyTitle" Text="A little space for your next idea." FontSize="13" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyHelp" Text="Try another search or add a prompt with Ctrl+N." FontSize="11.5" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="4" Margin="0,6,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="Hint" Text="I / K  navigate     J / L / Tab  category     Enter  copy" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
        <TextBlock x:Name="CountLabel" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
      </Grid>
    </Grid>
  </Border>
</Window>
