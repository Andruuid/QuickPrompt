<Window x:Class="QuickPrompt.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="QuickPrompt Settings" Width="620" Height="580" ResizeMode="NoResize" ShowInTaskbar="True">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl Background="{StaticResource Panel}" BorderThickness="0">
      <TabItem Header="General"><StackPanel Margin="10,16,10,0">
        <TextBlock Text="Always within reach." FontSize="21" FontWeight="SemiBold" Margin="0,0,0,20"/>
        <TextBlock Text="Show / hide shortcut" Margin="0,0,0,6"/><ComboBox x:Name="HotkeyBox" Width="200" HorizontalAlignment="Left" Padding="8" AutomationProperties.Name="Global shortcut"/>
        <TextBlock Text="If another launcher uses Alt+Space, close it or choose a different shortcut." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,12"/>
        <CheckBox x:Name="RememberBox" Content="Remember the last category"/>
        <CheckBox x:Name="AllCategoriesBox" Content="Search all categories when typing a query"/>
        <TextBlock Text="The launcher stays above other windows and hides when you click away.&#10;It stays available in your system tray until you choose Exit." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,0"/>
      </StackPanel></TabItem>
      <TabItem x:Name="CategoriesTab" Header="Categories"><StackPanel Margin="10,16,10,0">
        <TextBlock Text="Your categories. Your workflow." FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Text="Rename, reorder, or delete a category and its prompts. Deletions are backed up before saving." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,18"/>
        <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource Text}" AllowDrop="True" PreviewDragOver="OnCategoryDragOver" PreviewDrop="OnCategoryDrop" DragLeave="OnCategoryDragLeave" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Category order">
          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,3"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
              <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
            </ControlTemplate></Setter.Value></Setter>
          </Style></ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate><DataTemplate>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/><ColumnDefinition Width="32"/><ColumnDefinition Width="64"/></Grid.ColumnDefinitions>
              <Border Background="Transparent" Cursor="SizeNS" ToolTip="Drag to reorder this category" PreviewMouseLeftButtonDown="OnCategoryDragStart" MouseMove="OnCategoryDragMove" MouseLeftButtonUp="OnCategoryDragEnd">
                <TextBlock Text="⠿" FontSize="22" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" AutomationProperties.Name="Category name"/>
              <Button Grid.Column="2" Content="↑" Padding="0" Margin="5,0,0,0" Click="OnCategoryUp" ToolTip="Move category up" AutomationProperties.Name="Move category up"/>
              <Button Grid.Column="3" Content="↓" Padding="0" Margin="4,0,0,0" Click="OnCategoryDown" ToolTip="Move category down" AutomationProperties.Name="Move category down"/>
              <Button Grid.Column="4" Content="Delete" Padding="6,0" FontSize="11" Foreground="#FFB5B5" Margin="6,0,0,0" Click="OnDeleteCategory" ToolTip="Delete this category and all its prompts" AutomationProperties.Name="Delete category"/>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="AddCategoryButton" Content="+ Add category" HorizontalAlignment="Left" Margin="32,10,0,0" Padding="10,6" Click="OnAddCategory"/>
        <TextBlock x:Name="CategoryChangeNote" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="32,10,0,0"/>
      </StackPanel></TabItem>
      <TabItem Header="Documents"><StackPanel Margin="10,16,10,0">
        <TextBlock Text="Your files, one shortcut away." FontSize="21" FontWeight="SemiBold"/>
        <TextBlock Text="Put your documents in this folder, then search by filename." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,20"/>
        <TextBlock Text="Document folder" Margin="0,0,0,6"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="DocumentsFolderBox" AutomationProperties.Name="Document folder"/>
          <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Click="OnBrowseDocuments"/>
        </Grid>
        <CheckBox x:Name="SubfoldersBox" Content="Include subfolders" Margin="0,16,0,12"/>
        <TextBlock Text="PDF · JPG / JPEG · PNG · HTML / HTM · TXT&#10;SLN / SLNX · Windows shortcuts (.lnk)" FontWeight="SemiBold"/>
        <TextBlock Text="Search by filename, then press Enter to open in the default app.&#10;The list refreshes on launch; press F5 to refresh now." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,16"/>
        <Button Content="Open folder" HorizontalAlignment="Left" Click="OnOpenDocumentsFolder"/>
      </StackPanel></TabItem>
      <TabItem Header="Shortcuts"><StackPanel Margin="10,16,10,0">
        <TextBlock Text="Keep your hands on the keyboard." FontSize="21" FontWeight="SemiBold" Margin="0,0,0,18"/>
        <TextBlock LineHeight="25" Text="I / K or ↑ / ↓       Previous / next result&#10;J / L or Shift+Tab / Tab       Previous / next category&#10;Alt+1 … Alt+5       Jump to a category / Documents&#10;/ or Ctrl+F       Search (letters type normally here)&#10;Ctrl+Backspace       Leave search and return to navigation&#10;Enter       Copy prompt / open document, then hide&#10;F5       Refresh documents&#10;Ctrl+N / F2       New prompt / edit selected prompt&#10;Ctrl+Enter       Save in the prompt editor&#10;Escape       Hide launcher / cancel dialog&#10;Ctrl+,       Settings"/>
      </StackPanel></TabItem>
      <TabItem x:Name="AboutTab" Header="About"><ScrollViewer x:Name="AboutScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="10,16,10,0">
        <TextBlock Text="quickprompt" FontSize="27" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionLabel" Foreground="{StaticResource Muted}" Margin="0,8,0,24"/>
        <TextBlock Text="Local by design" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock Text="Your prompts are saved on this PC. No accounts, no AI calls, no background network requests. Copy a prompt, then paste it into any LLM." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,20"/>
        <TextBlock Text="Library file (a backup is kept alongside it):" Margin="0,0,0,8"/>
        <TextBox x:Name="DataPath" IsReadOnly="True" TextWrapping="Wrap" AutomationProperties.Name="Library file path"/>
        <Button x:Name="OpenBackupsButton" Content="Open backups" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnOpenBackups"/>
        <TextBlock x:Name="BackupHelp" Text="Timestamped JSON and text backups are kept before prompt or category changes. Backups are never automatically removed." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <TextBlock x:Name="ErrorLabel" Grid.Row="1" Foreground="#FFB5B5" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancel" IsCancel="True" Width="85" Margin="0,0,8,0"/><Button Content="Save settings" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="OnSave"/></StackPanel>
  </Grid>
</Window>
