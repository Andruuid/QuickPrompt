<Window x:Class="QuickPrompt.DeleteCategoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Delete category — QuickPrompt" Width="480" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False">
  <StackPanel Margin="24">
    <TextBlock Text="Delete this category?" FontSize="21" FontWeight="SemiBold"/>
    <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,14,0,12"/>
    <TextBlock Text="When you save settings, a timestamped JSON and text backup will preserve the category and all its prompts in both languages. If the backup fails, nothing is deleted." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/>
    <TextBlock Text="Cancel settings to undo the pending deletion." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button Content="Cancel" IsCancel="True" IsDefault="True" Margin="0,0,8,0"/>
      <Button Content="Delete category" Foreground="#FFB5B5" Click="OnConfirm"/>
    </StackPanel>
  </StackPanel>
</Window>
