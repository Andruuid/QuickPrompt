<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\QuickPrompt.ico</ApplicationIcon>
    <Version>0.4.0</Version>
    <Product>QuickPrompt</Product>
    <Description>Prompt and document launcher for Windows</Description>
    <Company>QuickPrompt</Company>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <EmbeddedResource Include="Assets\QuickPrompt.ico" />
  </ItemGroup>
</Project>
