<Window x:Class="QuickPrompt.PromptEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="New prompt — QuickPrompt" Width="640" Height="700" MinWidth="520" MinHeight="580" ShowInTaskbar="True" PreviewKeyDown="OnKeyDown">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock x:Name="Heading" Text="A prompt, ready when you are." FontSize="21" FontWeight="SemiBold"/>
      <TextBlock Text="Keep one English title and description. Add the prompt text in English, German, or both." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/>
      <CheckBox x:Name="NonBilingualBox" Content="Non-bilingual — use one version in both languages" IsChecked="False" Checked="OnLanguageModeChanged" Unchecked="OnLanguageModeChanged" Margin="0,12,0,0" AutomationProperties.Name="Non-bilingual prompt"/>
      <TextBlock x:Name="LanguageModeHelp" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
        <Button x:Name="EnglishButton" Content="EN · English" Tag="en" Click="OnLanguage" Margin="0,0,8,0" AutomationProperties.Name="Edit English translation"/>
        <Button x:Name="GermanButton" Content="DE · Deutsch" Tag="de" Click="OnLanguage" AutomationProperties.Name="Edit German translation"/>
        <TextBlock x:Name="TranslationStatus" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/>
      </StackPanel>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0"><TextBlock Text="Title (English, shared)" Margin="0,0,0,6"/><TextBox x:Name="NameBox" MaxLength="100" AutomationProperties.Name="Prompt name"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Category" Margin="0,0,0,6"/><ComboBox x:Name="CategoryBox" Padding="8" Height="37" VerticalContentAlignment="Center" AutomationProperties.Name="Category"/></StackPanel>
    </Grid>
    <StackPanel Grid.Row="2" Margin="0,0,0,14"><TextBlock Text="Description (English, shared)" Margin="0,0,0,6"/><TextBox x:Name="DescriptionBox" MaxLength="240" AutomationProperties.Name="Description"/></StackPanel>
    <Grid Grid.Row="3"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="ContentLabel" Text="Prompt · English" Margin="0,0,0,6"/><TextBox x:Name="ContentBox" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" TextChanged="OnContentChanged" AutomationProperties.Name="Prompt text" ToolTip="Use placeholders like {FileName}. You'll fill them in before copying."/>
    </Grid>
    <TextBlock x:Name="ErrorLabel" Grid.Row="4" Foreground="#FFB5B5" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <Grid Grid.Row="5" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button x:Name="DeleteButton" Content="Delete prompt" HorizontalAlignment="Left" Foreground="#FFB5B5" Click="OnDelete"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/><Button Content="Save prompt   Ctrl+Enter" Style="{StaticResource PrimaryButton}" Click="OnSave"/></StackPanel>
    </Grid>
  </Grid>
</Window>
