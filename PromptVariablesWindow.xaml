<Window x:Class="QuickPrompt.PromptVariablesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="Fill prompt — QuickPrompt" Width="500" Height="200" MinWidth="380" MinHeight="200"
        ShowInTaskbar="False" PreviewKeyDown="OnKeyDown">
  <Grid Margin="22,12,22,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="NameLabel" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,14,0"/>
      <TextBlock x:Name="ProgressLabel" Grid.Column="1" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
    </Grid>
    <TextBox x:Name="ValueBox" Grid.Row="1" MinHeight="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
    <TextBlock Grid.Row="2" Text="Enter to continue · Shift+Enter for a new line" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
    <TextBlock x:Name="ErrorLabel" Grid.Row="3" Foreground="#FFB5B5" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
</Window>
